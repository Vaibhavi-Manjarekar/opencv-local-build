__all__: list[str] = []

import cv2
import cv2.typing
import typing as _typing


# Enumerations
RENDER_SIMPLE: int
RENDER_SHADING: int
RENDER_WIREFRAME: int
RenderMode = int
"""One of [RENDER_SIMPLE, RENDER_SHADING, RENDER_WIREFRAME]"""



# Functions
def destroyObject(win_name: str, obj_name: str) -> None: ...

def setGridVisible(win_name: str, visible: bool) -> None: ...

def setObjectPosition(win_name: str, obj_name: str, position: cv2.typing.Vec3f) -> None: ...

def setObjectRotation(win_name: str, obj_name: str, rotation: cv2.typing.Vec3f) -> None: ...

def setPerspective(win_name: str, fov: float, z_near: float, z_far: float) -> None: ...

def setSky(win_name: str, color: cv2.typing.Vec3f) -> None: ...

def setSun(win_name: str, direction: cv2.typing.Vec3f, ambient: cv2.typing.Vec3f, diffuse: cv2.typing.Vec3f) -> None: ...

def showBox(win_name: str, obj_name: str, size: cv2.typing.Vec3f, color: cv2.typing.Vec3f, mode: RenderMode = ...) -> None: ...

@_typing.overload
def showLines(win_name: str, obj_name: str, points: cv2.typing.MatLike) -> None: ...
@_typing.overload
def showLines(win_name: str, obj_name: str, points: cv2.UMat) -> None: ...

@_typing.overload
def showMesh2(win_name: str, obj_name: str, verts: cv2.typing.MatLike) -> None: ...
@_typing.overload
def showMesh2(win_name: str, obj_name: str, verts: cv2.UMat) -> None: ...

def showPlane(win_name: str, obj_name: str, size: cv2.typing.Vec2f, color: cv2.typing.Vec3f, mode: RenderMode = ...) -> None: ...

@_typing.overload
def showPoints(win_name: str, obj_name: str, points: cv2.typing.MatLike) -> None: ...
@_typing.overload
def showPoints(win_name: str, obj_name: str, points: cv2.UMat) -> None: ...

@_typing.overload
def showRGBD(win_name: str, obj_name: str, img: cv2.typing.MatLike, intrinsics: cv2.typing.Matx33f, scale: float = ...) -> None: ...
@_typing.overload
def showRGBD(win_name: str, obj_name: str, img: cv2.UMat, intrinsics: cv2.typing.Matx33f, scale: float = ...) -> None: ...

def showSphere(win_name: str, obj_name: str, radius: float, color: cv2.typing.Vec3f, mode: RenderMode = ..., divs: int = ...) -> None: ...


